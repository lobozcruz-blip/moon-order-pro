      {
        "name": "create_order",
        "title": "Crear pedido",
        "description": "Crea un pedido completo de Cookies Moon para una clienta existente: artículos (con modalidad y tamaño para cortadores), tipo de entrega y datos de envío o entrega personal. El folio, los precios y los totales se calculan en el servidor.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador de la clienta (usa search_customers o upsert_customer)."
            },
            "delivery_type": {
              "description": "Tipo de entrega del pedido.",
              "type": "string",
              "enum": [
                "envio",
                "entrega_personal"
              ]
            },
            "priority": {
              "description": "Prioridad.",
              "type": "string",
              "enum": [
                "baja",
                "normal",
                "alta",
                "urgente"
              ]
            },
            "due_date": {
              "description": "Fecha de entrega en formato AAAA-MM-DD.",
              "type": "string"
            },
            "notes": {
              "description": "Notas generales del pedido.",
              "type": "string"
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "Identificador del producto del catálogo."
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999,
                    "description": "Cantidad de piezas."
                  },
                  "modality": {
                    "description": "Sólo cortadores: modalidad.",
                    "type": "string",
                    "enum": [
                      "cutter_only",
                      "cutter_with_stamp"
                    ]
                  },
                  "size_cm": {
                    "description": "Sólo cortadores: tamaño en centímetros.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "notes": {
                    "description": "Nota del artículo.",
                    "type": "string"
                  }
                },
                "required": [
                  "product_id",
                  "quantity"
                ]
              },
              "description": "Artículos del pedido."
            },
            "shipping": {
              "description": "Datos de envío cuando delivery_type es envio.",
              "type": "object",
              "properties": {
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "street": {
                  "type": "string"
                },
                "ext_number": {
                  "type": "string"
                },
                "int_number": {
                  "type": "string"
                },
                "neighborhood": {
                  "type": "string"
                },
                "municipality": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "postal_code": {
                  "type": "string"
                },
                "references_text": {
                  "type": "string"
                },
                "special_instructions": {
                  "type": "string"
                }
              }
            },
            "personal": {
              "description": "Datos de entrega personal cuando delivery_type es entrega_personal.",
              "type": "object",
              "properties": {
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "place": {
                  "type": "string"
                },
                "delivery_date": {
                  "type": "string"
                },
                "delivery_time": {
                  "type": "string"
                },
                "instructions": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "customer_id",
            "items"
          ]
        },
        "outputSchema": null
